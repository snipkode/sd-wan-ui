UI_PORT=3001
UI_TOKEN=
SD_OFFLINE_IMAGE=snipkode/sd-wan-offline:latest
SD_ALL_IMAGE=snipkode/sd-wan:latest
SD_UI_IMAGE=snipkode/sd-wan-ui:latest
SD_IMAGE=snipkode/sd-wan-infer:latest
# Compute: cpu | vulkan | cuda | auto, atau penempatan per modul
# (contoh: diffusion=vulkan0,clip=cpu,vae=vulkan0). auto hanya bekerja pada SD_RUNNER=local.
SD_BACKEND=cpu
# Tempat bobot model disimpan (disk | cpu | diffusion=vulkan0). Kosong = ikut backend.
SD_PARAMS_BACKEND=
# Batas memori GPU dalam GiB (contoh: 4 atau cuda0=4,vulkan0=2). Kosong = tanpa batas.
SD_MAX_VRAM=
# Jumlah thread CPU untuk backend cpu. Kosong = pemilihan otomatis dari pustaka.
SD_THREADS=
GPU_DEVICES=all
VULKAN_DEVICE=/dev/dri
SD_EXTRA_ARGS=
INPUT_HOST_DIR=${PWD}/input
INPAINT_MODEL_HOST_DIR=${PWD}/models/inpaint
KEEP_AVI=0
