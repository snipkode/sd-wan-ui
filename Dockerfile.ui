FROM node:22-alpine

RUN apk add --no-cache ca-certificates curl docker-cli ffmpeg

WORKDIR /app

COPY server.js ./
COPY public ./public
COPY scripts ./scripts

ENV HOST=0.0.0.0 \
    PORT=3001 \
    MODEL_DIR=/app/models \
    OUT_DIR=/app/out \
    STATE_FILE=/app/runtime/state.json \
    SD_IMAGE=snipkode/sd-wan-infer:latest \
    SD_BACKEND=cpu \
    FFMPEG_BIN=/usr/bin/ffmpeg \
    KEEP_AVI=0

RUN mkdir -p /app/models /app/out /app/runtime

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD curl -fsS http://127.0.0.1:3001/api/health || exit 1

CMD ["node", "server.js"]
